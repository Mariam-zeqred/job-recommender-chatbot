# Copy to .env and edit, then export it before `make serve` (e.g. `set -a; . ./.env; set +a`):
# nothing reads the file automatically. Everything here is optional: the demo runs with no keys.

# Which LLM backend the interview chatbot may use for follow-up questions and feedback.
# "none" (default) = rule-based only, no network calls, no key needed.
# "http" = any OpenAI-compatible chat-completions endpoint (see src/jobrec/providers/http_chat.py).
JOBREC_LLM_PROVIDER=none
JOBREC_LLM_BASE_URL=https://api.example.com/v1
JOBREC_LLM_MODEL=replace-me
JOBREC_LLM_API_KEY=replace-me

# Embedding backend: "tfidf" (default, no download), "glove" (needs `make vectors`),
# "minilm" (needs `pip install -r requirements-minilm.txt` and the model cached locally).
JOBREC_EMBEDDER=tfidf
